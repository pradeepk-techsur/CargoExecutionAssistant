{
  "name": "cargoexec",
  "private": true,
  "type": "module",
  "workspaces": ["contract", "server"],
  "engines": { "node": "22.11.0" },
  "scripts": {
    "migrate": "node --env-file=.env server/scripts/migrate.mjs",
    "test:unit": "vitest run server/test/unit",
    "test:db": "vitest run server/test/db",
    "test:arch": "vitest run server/test/architecture",
    "test": "npm run test:unit && npm run test:db && npm run test:arch",
    "typecheck": "tsc -b contract server"
  },
  "dependencies": {
    "pg": "8.13.1",
    "node-pg-migrate": "7.9.0"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vitest": "2.1.5",
    "@types/node": "22.9.0",
    "@types/pg": "8.11.10"
  }
}
