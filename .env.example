POSTGRES_SUPERUSER_PASSWORD=cargoexec_local_superuser
CARGOEXEC_OWNER_PASSWORD=cargoexec_local_owner
CARGOEXEC_APP_PASSWORD=cargoexec_local_app
CARGOEXEC_AI_PASSWORD=cargoexec_local_ai
PGHOST=localhost
PGPORT=5432
DATABASE_URL_OWNER=postgres://cargoexec_owner:cargoexec_local_owner@localhost:5432/cargoexec
DATABASE_URL_APP=postgres://cargoexec_app:cargoexec_local_app@localhost:5432/cargoexec
DATABASE_URL_AI=postgres://cargoexec_ai:cargoexec_local_ai@localhost:5432/cargoexec
DATABASE_URL_SUPERUSER=postgres://postgres:cargoexec_local_superuser@localhost:5432/postgres
# The AI recommendation environment (§6.6). PHASE 7 POSTURE (FR-9.20 /
# TechArch §5.9): a demonstration or production deployment must call a REAL
# hosted LLM, not the deterministic fake provider. These four keys ship EMPTY
# here on purpose — loadConfig() refuses to boot until you choose explicitly:
#   • a real provider: set AI_PROVIDER_URL to its https:// chat/completions
#     endpoint, AI_API_KEY to a valid key, and AI_MODEL_ID to the exact model
#     identifier (see docs/ai-provider-configuration.md); or
#   • the fake provider (local/test only, never a deployment): set
#     AI_PROVIDER_URL=fake:deterministic — an explicit, deliberate override,
#     never a silent default. AI_API_KEY is not required in this posture.
# The same rule applies to any deployment via docker-compose.yml, whose
# AI_PROVIDER_URL is now a mandatory (no-default) variable: `docker compose up`
# fails loudly, naming AI_PROVIDER_URL, when it is unset.
# PROMPT_VERSION must be byte-identical to server/src/ai/prompt/manifest.json
# ('2026.09.1') or the boot digest self-check fails.
AI_PROVIDER_URL=
AI_API_KEY=
AI_MODEL_ID=
PROMPT_VERSION=
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
SESSION_COOKIE_PROFILE=governed
FRAME_ANCESTORS=
LOG_LEVEL=info

# The bootstrap specialist account (F1 FR-1.13 / TechArch §8.7 step 5). The web
# container runs `create-specialist --from-env --if-absent` between migrate and
# serve, so the sign-in screen can actually be signed into after a cold start.
# This is NOT seed data (PRD §10 #7): it inserts ONE row in `specialists` and no
# cargo entries, cases, decisions or audit history. Change the password before
# any non-local use; when any of the three keys is unset the bootstrap creates
# nothing and the container still boots.
BOOTSTRAP_SPECIALIST_EMAIL=specialist@cbp.example.gov
# Quoted because the value contains a space. Compose's own .env parser accepts
# it unquoted, but the dev-server wrapper loads this file by SOURCING it
# (`set -a; . ./.env`), where `A. Rivera` parses as the command `A.` with the
# argument `Rivera` and aborts the boot with `Rivera: command not found` (127).
BOOTSTRAP_SPECIALIST_NAME="A. Rivera"
BOOTSTRAP_SPECIALIST_PASSWORD=cargoexec-local-demo-password
